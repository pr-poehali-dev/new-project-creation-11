{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing email returns 400",
      "method": "POST",
      "path": "/",
      "body": {"amount": 1000, "return_url": "https://faloleeva.ru/order-status"},
      "expectedStatus": 400
    },
    {
      "name": "Invalid amount returns 400",
      "method": "POST",
      "path": "/",
      "body": {"amount": 0, "user_email": "test@example.com", "return_url": "https://faloleeva.ru/order-status"},
      "expectedStatus": 400
    }
  ]
}
