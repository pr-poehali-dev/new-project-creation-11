{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing fields returns 400",
      "method": "POST",
      "path": "/",
      "body": {"tariff_id": "group"},
      "expectedStatus": 400
    },
    {
      "name": "Invalid email returns 400",
      "method": "POST",
      "path": "/",
      "body": {"tariff_id": "group", "tariff_title": "Опора", "user_name": "Тест", "user_email": "not-an-email"},
      "expectedStatus": 400
    },
    {
      "name": "Valid request returns 200",
      "method": "POST",
      "path": "/",
      "body": {"tariff_id": "group", "tariff_title": "Терапевтическая группа Опора", "user_name": "Тест Тестов", "user_email": "test@example.com", "user_phone": "+79991234567"},
      "expectedStatus": 200
    }
  ]
}
